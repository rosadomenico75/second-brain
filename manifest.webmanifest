{
  "name": "Second brain",
  "short_name": "Brain",
  "description": "Archivio personale di link, foto, appunti e vocali",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F6F5F9",
  "theme_color": "#534AB7",
  "lang": "it",
  "icons": [
    { "src": "lume-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "lume-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "lume-mask.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [ { "name": "files", "accept": ["image/*"] } ]
    }
  }
}
